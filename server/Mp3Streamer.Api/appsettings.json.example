{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5288",
  "ConnectionStrings": {
    "Library": "Data Source=C:\\path\\to\\Mp3Streamer\\server\\Mp3Streamer.Api\\library.db"
  },
  "LibraryRootPaths": [ "C:\\path\\to\\your\\Music" ]

  // Optional — only needed if the catalog comes from a real iTunes / Apple
  // Music install instead of scanning LibraryRootPaths from disk.
  // "CatalogSource": "ItunesXml",

  // Required when CatalogSource is "ItunesXml": the backend watches this file
  // and reconciles track add/remove whenever iTunes rewrites it. The file is
  // only ever read (copied to a temp location first) — never modified.
  // In iTunes: Edit > Preferences > Advanced > "Share iTunes Library XML with
  // other applications" must be enabled for this file to exist / stay current.
  // "ItunesXml": {
  //   "LibraryXmlPath": "C:\\Users\\you\\Music\\iTunes\\iTunes Music Library.xml",
  //   "SyncIntervalMinutes": 15
  // }
}
